<Window
    x:Class="Cairn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cairn">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView x:Name="Nav" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="BackupTab" Content="Back up" Tag="backup" Icon="Save" />
            <NavigationViewItem Content="Set up" Tag="setup" Icon="Download" />
        </NavigationView.MenuItems>

        <Grid Padding="24,12,24,20">
            <!-- Back up: scan this PC, untick what to leave out, save a snapshot. -->
            <Grid x:Name="BackupPage" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Back up this PC" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Cairn saves this PC's setup (programs, settings, taskbar, Git and SSH config), never your files. Scan, untick anything you don't want, then back up. A new snapshot is only saved when something changed." />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Backup folder" VerticalAlignment="Center" />
                    <TextBox x:Name="FolderBox" Grid.Column="1" LostFocus="FolderBox_LostFocus"
                             PlaceholderText="A folder on this PC, or a NAS share like \\nas\backups\Cairn" />
                    <Button Grid.Column="2" Content="Choose…" Click="ChooseFolder_Click" />
                </Grid>
                <Border Grid.Row="2" BorderThickness="1" CornerRadius="8"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ScrollViewer Padding="16,8,16,8">
                        <StackPanel x:Name="BackupList">
                            <TextBlock Margin="0,8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Click Scan this PC to see what Cairn would back up." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="BackupBusy" IsActive="False" Width="18" Height="18" />
                        <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ScanButton" Grid.Column="1" Content="Scan this PC" Click="Scan_Click" />
                    <Button x:Name="BackupButton" Grid.Column="2" Content="Back up" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" Click="Backup_Click" />
                </Grid>
            </Grid>

            <!-- Set up: pick a backup, tick what to set up, preview, then set up. -->
            <Grid x:Name="SetupPage" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Set up this PC" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Pick a backup from a Mac or another PC. Preview shows what would change without changing anything; Set up makes the changes." />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Backup" VerticalAlignment="Center" />
                    <ComboBox x:Name="BackupPicker" Grid.Column="1" HorizontalAlignment="Stretch"
                              PlaceholderText="No backups in the backup folder yet" SelectionChanged="BackupPicker_SelectionChanged" />
                    <Button Grid.Column="2" Content="Refresh" Click="RefreshBackups_Click" />
                    <Button Grid.Column="3" Content="Open file…" Click="OpenBackup_Click" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Border BorderThickness="1" CornerRadius="8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer Padding="16,8,16,8">
                            <StackPanel x:Name="SetupList" />
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" BorderThickness="1" CornerRadius="8"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer Padding="16,8,16,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Do by hand" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ByHandText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="Not carried over" Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="NotCarriedText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <TextBox x:Name="SetupLog" Grid.Row="3" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="What Set up does shows here." />
                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="SetupBusy" IsActive="False" Width="18" Height="18" />
                        <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="PreviewButton" Grid.Column="1" Content="Preview" IsEnabled="False" Click="Preview_Click" />
                    <Button x:Name="ApplyButton" Grid.Column="2" Content="Set up" IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" />
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
