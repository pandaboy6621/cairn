<Window
    x:Class="Cairn.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cairn">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Laid out like the Mac app: this PC and the categories on the left, the page on
         the right. Rows, tiles and cards are built in MainWindow.xaml.cs. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (drawn by us, so Mica runs right to the top). -->
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" Spacing="10" Padding="16,0,0,0" VerticalAlignment="Center">
            <Image x:Name="TitleIcon" Width="18" Height="18" />
            <TextBlock Text="Cairn" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Padding="8,0,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="10,4,10,14" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="DeviceTile" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DeviceDetail" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ProgressRing x:Name="DeviceBusy" Grid.Column="2" Width="20" Height="20" IsActive="False" />
                </Grid>

                <ListView x:Name="Sidebar" Grid.Row="1" SelectionMode="Single" SelectionChanged="Sidebar_SelectionChanged" />

                <Border x:Name="SelectionSummary" Grid.Row="2" Padding="12" Margin="4,0" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Selected for backup" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectionText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ProgressBar x:Name="SelectionBar" Maximum="1" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Page -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Home -->
                    <ScrollViewer x:Name="HomePage">
                        <StackPanel MaxWidth="1100" Padding="32,28,32,28" Spacing="24">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Your PC's setup" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="HomeSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Grid x:Name="StatsRow" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <!-- Back up, Set up, Sync: built in code (Dashboard.cs). -->
                            <Grid x:Name="CardsRow" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Text="Cairn saves your setup (programs, settings, taskbar, Git and SSH config), never your files. A new snapshot is only saved when something changed, and lines that look like passwords or tokens are left out." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- A category: Programs, Settings, Taskbar, Config files -->
                    <Grid x:Name="CategoryPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="CategoryHeader" Padding="24,18,24,18" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="CategoryTile" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="CategoryTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="CategorySubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" Width="240" VerticalAlignment="Center"
                                            PlaceholderText="Search" QueryIcon="Find" TextChanged="Search_TextChanged" />
                            <Button x:Name="SelectAllButton" Grid.Column="3" VerticalAlignment="Center" Click="SelectAll_Click" />
                        </Grid>
                        <ScrollViewer x:Name="CategoryScroller" Grid.Row="1" Padding="24,4,24,24" />
                    </Grid>

                    <!-- Set up this PC from a backup -->
                    <Grid x:Name="SetupPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="SetupHeader" Padding="24,18,24,18" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="SetupRingHost" Grid.Column="2" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="SetupTile" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Set up this PC" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="SetupSubtitle" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pick a backup from a Mac or another PC. Preview shows what would change; nothing changes until you click Set up." />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="24,0,24,12" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="From" VerticalAlignment="Center" />
                            <ComboBox x:Name="BackupPicker" Grid.Column="1" HorizontalAlignment="Stretch"
                                      PlaceholderText="No backups in the backup folder yet" SelectionChanged="BackupPicker_SelectionChanged" />
                            <Button Grid.Column="2" ToolTipService.ToolTip="Look for backups again" Click="RefreshBackups_Click">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="3" Content="Open file…" Click="OpenBackup_Click" />
                        </Grid>
                        <Grid Grid.Row="2" Padding="24,0,24,24" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="SetupScroller">
                                <TextBlock Margin="0,24" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pick a backup to see what it would set up." />
                            </ScrollViewer>
                            <ScrollViewer Grid.Column="1">
                                <StackPanel Spacing="12">
                                    <Border Style="{StaticResource CairnCard}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Do by hand" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="ByHandText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Nothing yet." />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CairnCard}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Not carried over" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="NotCarriedText" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Nothing yet." />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="LogCard" Style="{StaticResource CairnCard}" Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="What happened" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBox x:Name="SetupLog" Height="220" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Padding="32,28,32,28" Spacing="16">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

                            <Border Style="{StaticResource CairnCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Backup folder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="SettingsFolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="A folder on this PC or a NAS share. Your Macs and PCs can all back up into the same folder." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Choose…" Click="ChooseFolder_Click" />
                                        <Button Content="Open" Click="OpenFolder_Click" />
                                        <Button x:Name="DefaultFolderButton" Content="Use default" Click="DefaultFolder_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CairnCard}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="Back up automatically" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="AutoToggle" HorizontalAlignment="Right" MinWidth="0"
                                                      OnContent="On" OffContent="Off" Toggled="AutoToggle_Toggled" />
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Cairn checks in the background, even with this window closed, and saves a new snapshot only when something changed. It keeps what you unticked left out. It uses Windows Task Scheduler and runs only while you're signed in." />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="Check every" VerticalAlignment="Center" />
                                        <ComboBox x:Name="IntervalPicker" MinWidth="160" SelectionChanged="Interval_SelectionChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="AutoStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <HyperlinkButton Content="Show the automatic backup log" Padding="0" Click="ShowLog_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CairnCard}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="About Cairn" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Cairn backs up a computer's setup (programs, settings, taskbar, Git and SSH config), never your files, and sets up a new Mac or PC from it." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sync with other computers -->
                    <ScrollViewer x:Name="SyncPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="820" Padding="32,28,32,28" Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Sync" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Keep your PCs in step through the backup folder or NAS, and bring in changes from your Macs. Nothing changes here until you review and set up the changes." />
                                </StackPanel>
                                <ToggleSwitch x:Name="SyncToggle" Grid.Column="1" MinWidth="0" OnContent="On" OffContent="Off" Toggled="SyncToggle_Toggled" />
                            </Grid>

                            <Border Style="{StaticResource CairnCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Changes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SyncNowButton" Content="Sync now" Click="SyncNow_Click" />
                                        <Button x:Name="ReviewButton" Content="Review changes" IsEnabled="False"
                                                Style="{StaticResource AccentButtonStyle}" Click="Review_Click" />
                                    </StackPanel>
                                    <StackPanel x:Name="SyncNoticesPanel" Spacing="8" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CairnCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="What syncs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ComboBox x:Name="SyncPresetPicker" MinWidth="200" SelectionChanged="SyncPreset_SelectionChanged" />
                                    <TextBlock x:Name="SyncPresetSummary" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                                    <Grid>
                                        <TextBlock Text="Take changes from my Macs" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="IncludeMacsToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="On" OffContent="Off"
                                                      Toggled="IncludeMacs_Toggled" />
                                    </Grid>
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Your Macs' programs, settings, Dock and config come in translated for Windows: a Homebrew app becomes its Windows version, the Dock becomes the taskbar. It's one way: your Macs don't take changes from PCs, so nothing goes back and forth." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CairnCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Computers" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Only computers you accept here are synced with. A computer asks once it turns sync on with the same backup folder. Check its ID matches the one it shows." />
                                    <StackPanel x:Name="SyncDevicesPanel" Spacing="8" />
                                    <StackPanel Spacing="2" Margin="0,6,0,0">
                                        <TextBlock Text="This PC's ID" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SyncIdText" IsTextSelectionEnabled="True" FontFamily="Cascadia Mono, Consolas" FontSize="16" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Status bar -->
                    <Grid Grid.Row="1" Padding="24,10,24,10" ColumnSpacing="8"
                          BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ProgressRing x:Name="Busy" IsActive="False" Width="16" Height="16" />
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="BackupActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ScanButton" Content="Scan again" Click="Scan_Click" />
                            <Button x:Name="BackupButton" Content="Back up now" IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}" Click="Backup_Click" />
                        </StackPanel>
                        <StackPanel x:Name="SetupActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="SkipButton" Content="Skip this one" Visibility="Collapsed" Click="Skip_Click"
                                    ToolTipService.ToolTip="Give up on the program installing now and go on to the next" />
                            <Button x:Name="StopButton" Content="Stop" Visibility="Collapsed" Click="Stop_Click"
                                    ToolTipService.ToolTip="Stop after this step; nothing that's done is undone" />
                            <Button x:Name="PreviewButton" Content="Preview" IsEnabled="False" Click="Preview_Click" />
                            <Button x:Name="ApplyButton" Content="Set up" IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
